---
// 商品卡：名称、张数、尺寸、价格、预览轮播、购买按钮。
import { ui } from '../content/site';
import { formatPrice, pagePath, previewsForProduct, productPage, t, type Lang, type Product } from '../lib/site';
import BuyLink from './BuyLink.astro';
import Carousel from './Carousel.astro';

interface Props {
  product: Product;
  lang: Lang;
  badge?: string;
  sizes?: string;
}
const { product, lang, badge, sizes = '(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw' } = Astro.props;
const name = t(product.name, lang);
const images = previewsForProduct(product).slice(0, 6);
const href = pagePath(lang, productPage(product));
---

<article class="flex min-w-0 flex-col">
  <div class="relative">
    <Carousel images={images} lang={lang} label={name} sizes={sizes} frame="aspect-square sm:aspect-[4/5]" />
    {badge && <p class="pointer-events-none absolute top-0 left-0 bg-seal px-2.5 py-1 text-[0.68rem] font-medium tracking-[0.2em] text-white uppercase">{badge}</p>}
  </div>
  <div class="flex flex-1 flex-col pt-5">
    <div class="flex items-baseline justify-between gap-4">
      <h3 class="text-[1.4rem]"><a href={href} class="transition-colors hover:text-seal">{name}</a></h3>
      <p class="shrink-0 font-serif text-[1.6rem] leading-none tabular-nums">
        <span class="sr-only">{t(ui.labelPrice, lang)}: </span>{formatPrice(product.price, lang)}
      </p>
    </div>
    <p class="mt-2 text-[0.8rem] tracking-[0.06em] text-ink-soft">
      {t(ui.imagesCount, lang, { count: product.count })}<span aria-hidden="true"> · </span>{product.ratio}
      {product.resolution && <><span aria-hidden="true"> · </span>{product.resolution}</>}
    </p>
    <p class="mt-3 flex-1 text-[0.95rem] text-ink-soft">{t(product.tagline, lang)}</p>
    <BuyLink href={product.gumroadUrl} lang={lang} class="mt-5 w-full" />
    <a href={href} class="link mt-1 inline-flex min-h-11 items-center self-start text-sm">{t(ui.details, lang)}<span class="sr-only">: {name}</span></a>
  </div>
</article>
