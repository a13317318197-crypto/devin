---
// 商品卡：名称、张数、尺寸、价格、预览轮播、购买按钮。
import { ui } from '../content/site';
import { formatPrice, pagePath, previewsForProduct, productPage, t, type Lang, type Product } from '../lib/site';
import BuyLink from './BuyLink.astro';
import Carousel from './Carousel.astro';

interface Props {
  product: Product;
  lang: Lang;
  badge?: string;
  sizes?: string;
}
const { product, lang, badge, sizes = '(min-width: 1024px) 22vw, (min-width: 640px) 45vw, 90vw' } = Astro.props;
const name = t(product.name, lang);
const images = previewsForProduct(product).slice(0, 6);
const href = pagePath(lang, productPage(product));
---

<article class="flex min-w-0 flex-col border border-line bg-paper">
  <Carousel images={images} lang={lang} label={name} sizes={sizes} />
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="text-2xl"><a href={href} class="hover:text-seal">{name}</a></h3>
      {badge && <span class="mt-1 shrink-0 border border-seal px-2 py-0.5 text-xs text-seal">{badge}</span>}
    </div>
    <p class="text-sm text-ink-soft">
      {t(ui.imagesCount, lang, { count: product.count })}<span aria-hidden="true"> · </span>{product.ratio}
      {product.resolution && <><span aria-hidden="true"> · </span>{product.resolution}</>}
    </p>
    <p class="flex-1">{t(product.tagline, lang)}</p>
    <p class="font-serif text-3xl">
      <span class="sr-only">{t(ui.labelPrice, lang)}: </span>{formatPrice(product.price, lang)}
    </p>
    <BuyLink href={product.gumroadUrl} lang={lang} class="w-full" />
    <a href={href} class="link -my-1 inline-flex min-h-11 items-center self-start text-sm">{t(ui.details, lang)}<span class="sr-only">: {name}</span></a>
  </div>
</article>
