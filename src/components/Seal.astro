---
// 印章：品牌中文名 +「印」，竖排、从右往左读。纯装饰，读屏软件会跳过。
import { site } from '../content/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const text = [...site.brand.zh].length === 3 ? site.brand.zh + '印' : site.brand.zh;
---

<span class:list={['seal', className]} lang="zh-Hans" aria-hidden="true">{text}</span>

<style>
  .seal {
    display: inline-block;
    box-sizing: content-box;
    height: 2.5em;
    padding: 0.28em;
    border-radius: 0.2em;
    background: var(--color-seal);
    color: #fff;
    font-family: var(--font-serif);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: 0;
    writing-mode: vertical-rl;
    text-align: center;
  }
</style>
