---
// 预览轮播：原生横向滚动，可滑动、可用按钮切换，点击图片打开灯箱。
import { ui } from '../content/site';
import { t, type Lang, type Preview } from '../lib/site';
import PreviewButton from './PreviewButton.astro';

interface Props {
  images: Preview[];
  lang: Lang;
  label: string;
  sizes?: string;
  eager?: boolean;
  /** 画框比例，例如 'aspect-[4/5]' */
  frame?: string;
}
const { images, lang, label, sizes, eager = false, frame = 'aspect-[4/5]' } = Astro.props;
---

<div class="mat relative min-w-0" data-carousel data-lightbox-group>
  <ul class:list={['carousel-track', frame]} aria-label={`${t(ui.carousel.label, lang)}: ${label}`}>
    {
      images.map((preview, index) => (
        <li class="h-full p-5">
          <PreviewButton
            preview={preview}
            lang={lang}
            sizes={sizes}
            eager={eager && index === 0}
            class="flex h-full items-center justify-center"
            imgClass="max-h-full w-auto! max-w-full shadow-[0_10px_30px_-12px_rgb(36_38_32/0.45)]"
          />
        </li>
      ))
    }
  </ul>
  {
    images.length > 1 && (
      <div class="absolute inset-x-0 bottom-2 flex items-center justify-between px-2">
        <button type="button" class="icon-btn" data-carousel-prev aria-label={t(ui.carousel.previous, lang)}>
          <span aria-hidden="true">‹</span>
        </button>
        <span class="rounded-full bg-paper/85 px-2.5 py-0.5 text-xs text-ink-soft tabular-nums" data-carousel-count aria-hidden="true">
          1 / {images.length}
        </span>
        <button type="button" class="icon-btn" data-carousel-next aria-label={t(ui.carousel.next, lang)}>
          <span aria-hidden="true">›</span>
        </button>
      </div>
    )
  }
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('.carousel-track');
    const count = root.querySelector<HTMLElement>('[data-carousel-count]');
    if (!track) continue;
    const total = track.children.length;
    const current = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (step: number) => {
      const next = (current() + step + total) % total;
      const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({ left: next * track.clientWidth, behavior: smooth ? 'smooth' : 'auto' });
    };
    root.querySelector('[data-carousel-prev]')?.addEventListener('click', () => go(-1));
    root.querySelector('[data-carousel-next]')?.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => {
      if (count) count.textContent = `${current() + 1} / ${total}`;
    }, { passive: true });
  }
</script>
