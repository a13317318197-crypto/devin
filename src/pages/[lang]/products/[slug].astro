---
// 商品详情页（四个商品共用这一个文件）
import { productPage as copy, products, site, ui } from '../../../content/site';
import AiLine from '../../../components/AiLine.astro';
import BuyLink from '../../../components/BuyLink.astro';
import Carousel from '../../../components/Carousel.astro';
import PlaceholderNotice from '../../../components/PlaceholderNotice.astro';
import PreviewButton from '../../../components/PreviewButton.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Base from '../../../layouts/Base.astro';
import { absoluteUrl, formatPrice, LANGS, pagePath, previewsForProduct, productPage, shareImage, t, type Lang, type Product } from '../../../lib/site';

export const getStaticPaths = () => LANGS.flatMap((lang) => products.map((product) => ({ params: { lang, slug: product.slug }, props: { product } })));
const lang = Astro.params.lang as Lang;
const { product } = Astro.props as { product: Product };
const name = t(product.name, lang);
const description = t(product.description, lang);
const images = previewsForProduct(product);
const page = productPage(product);
const isBundle = product.previews.length > 1;
const packs = products.filter((item) => item.previews.length === 1);
const related = products.filter((item) => item !== product);
const share = shareImage(isBundle ? 'desktop' : product.previews[0]);
const specs = [
  { label: t(ui.labelRatio, lang), value: product.ratio },
  ...(product.resolution ? [{ label: t(ui.labelResolution, lang), value: product.resolution }] : []),
  { label: t(ui.labelFormat, lang), value: product.format },
];
// 包含内容：单品列出张数/分辨率/格式；合集列出三个分包
const included = isBundle
  ? packs.map((pack) => `${t(copy.bundleLine, lang, { name: t(pack.name, lang), count: pack.count })} · ${pack.ratio} · ${pack.resolution} · ${pack.format}`)
  : [t(ui.imagesCount, lang, { count: product.count }), ...specs.map((spec) => `${spec.label}: ${spec.value}`)];
// Product 结构化数据：价格直接取自 site.ts
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description,
  sku: product.slug,
  url: absoluteUrl(pagePath(lang, page)),
  image: [absoluteUrl(share), ...images.slice(0, 3).map((image) => absoluteUrl(image.src))],
  brand: { '@type': 'Brand', name: site.brand.en },
  offers: {
    '@type': 'Offer',
    price: product.price.toFixed(2),
    priceCurrency: site.currency,
    availability: 'https://schema.org/InStock',
    url: product.gumroadUrl,
  },
};
---

<Base lang={lang} page={page} title={t(copy.titleSuffix, lang, { name })} description={description} image={share} jsonLd={jsonLd}>
  <div class="wrap pt-8 pb-28 md:pt-14 md:pb-20">
    <p class="eyebrow">
      <a href={pagePath(lang) + '#packs'} class="hover:text-seal">{t(ui.nav.packs, lang)}</a><span aria-hidden="true"> / </span>{name}
    </p>

    <div class="mt-5 grid grid-cols-[minmax(0,1fr)] gap-8 md:grid-cols-2 md:gap-12">
      <Carousel images={images} lang={lang} label={name} eager sizes="(min-width: 768px) 40vw, 90vw" frame={isBundle || product.previews[0] !== 'phone' ? 'aspect-square' : 'aspect-[4/5]'} />
      <div>
        <h1 class="h-page">{name}</h1>
        <p class="mt-2 text-ink-soft">{t(ui.imagesCount, lang, { count: product.count })}<span aria-hidden="true"> · </span>{product.ratio}</p>
        <p class="lead mt-5">{description}</p>
        <p class="mt-6 font-serif text-5xl"><span class="sr-only">{t(ui.labelPrice, lang)}: </span>{formatPrice(product.price, lang)}</p>
        <BuyLink href={product.gumroadUrl} lang={lang} class="mt-5 w-full sm:w-auto" />
        <p class="mt-3 text-sm text-ink-soft">{t(ui.buyNote, lang)}</p>
        <AiLine lang={lang} class="mt-5 border-t border-line pt-5" />
      </div>
    </div>

    <section class="mt-14 border-t border-line pt-10">
      <h2 class="text-3xl">{t(copy.previewHeading, lang)}</h2>
      <PlaceholderNotice lang={lang} class="mt-4" />
      <ul class="mt-6 columns-2 gap-3 md:columns-3 lg:columns-4" data-lightbox-group>
        {images.map((preview) => <li class="mat mb-3 break-inside-avoid p-1.5"><PreviewButton preview={preview} lang={lang} /></li>)}
      </ul>
    </section>

    <div class="mt-14 grid gap-10 border-t border-line pt-10 md:grid-cols-2 md:gap-14">
      <section>
        <h2 class="text-3xl">{t(copy.includedHeading, lang)}</h2>
        <ul class="mt-5 divide-y divide-line border-y border-line">
          {included.map((line) => <li class="py-3">{line}</li>)}
        </ul>
      </section>
      <section>
        <h2 class="text-3xl">{t(copy.howHeading, lang)}</h2>
        <ol class="mt-5 space-y-5">
          {
            copy.steps.map((step, index) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-3">
                <span class="flex size-10 items-center justify-center rounded-full border border-seal font-serif text-lg text-seal" aria-hidden="true">{index + 1}</span>
                <div>
                  <h3 class="text-xl">{t(step.title, lang)}</h3>
                  <p class="mt-1 text-ink-soft">{t(step.body, lang)}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>
    </div>

    <section class="mat mt-14 p-6 md:p-10">
      <h2 class="text-3xl">{t(copy.licenseHeading, lang)}</h2>
      <ul class="mt-5 space-y-3">
        <li class="flex gap-3"><span class="font-serif text-xl leading-7" aria-hidden="true">○</span><span>{t(copy.licenseAllowed, lang)}</span></li>
        <li class="flex gap-3"><span class="font-serif text-xl leading-7 text-seal" aria-hidden="true">×</span><span>{t(copy.licenseForbidden, lang)}</span></li>
      </ul>
      <a href={pagePath(lang, 'license')} class="link mt-5 inline-block">{t(copy.licenseLink, lang)}</a>
      <AiLine lang={lang} class="mt-5 border-t border-line pt-5" />
    </section>

    <section class="mt-14 border-t border-line pt-10">
      <h2 class="text-3xl">{t(copy.relatedHeading, lang)}</h2>
      <div class="mt-7 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((item) => <ProductCard product={item} lang={lang} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw" />)}
      </div>
    </section>
  </div>

  <!-- 手机上固定在底部的购买条 -->
  <div class="fixed inset-x-0 bottom-0 z-20 flex items-center justify-between gap-4 border-t border-line bg-paper/95 px-5 py-3 backdrop-blur md:hidden">
    <p class="font-serif text-2xl"><span class="sr-only">{name} · {t(ui.labelPrice, lang)}: </span>{formatPrice(product.price, lang)}</p>
    <BuyLink href={product.gumroadUrl} lang={lang} class="min-h-11 flex-1 px-4" />
  </div>
</Base>
