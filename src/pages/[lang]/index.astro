---
// 首页
import { home, products, site } from '../../content/site';
import PlaceholderNotice from '../../components/PlaceholderNotice.astro';
import PreviewButton from '../../components/PreviewButton.astro';
import ProductCard from '../../components/ProductCard.astro';
import Seal from '../../components/Seal.astro';
import Base from '../../layouts/Base.astro';
import { absoluteUrl, interleave, langStaticPaths, pagePath, previewsOf, t, type Lang } from '../../lib/site';

export const getStaticPaths = langStaticPaths;
const lang = Astro.params.lang as Lang;
const heroPhone = previewsOf('phone')[0];
const heroDesktop = previewsOf('desktop')[0];
const sampleImages = (['phone', 'avatar', 'desktop'] as const).map((category) => previewsOf(category)[1] ?? previewsOf(category)[0]).filter(Boolean);
const picks = interleave(['desktop', 'phone', 'avatar']).slice(0, 8);
const bundle = products[products.length - 1];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: `${site.brand.en} ${site.brand.zh}`,
  url: absoluteUrl(pagePath(lang)),
  inLanguage: lang === 'zh' ? 'zh-Hans' : 'en',
};
---

<Base lang={lang} page="" title={t(home.title, lang)} description={t(home.description, lang)} jsonLd={jsonLd}>
  <section class="hero-wash">
    <div class="wrap grid items-center gap-6 pt-5 pb-14 md:grid-cols-[1fr_1.05fr] md:gap-10 md:pt-16 md:pb-20 lg:gap-16 lg:pt-24 lg:pb-28">
      <div class="relative mx-auto w-[88%] max-w-md pt-2 pb-12 md:order-last md:w-full md:max-w-none md:pt-3 md:pb-16" data-lightbox-group>
        {
          heroDesktop && (
            <PreviewButton
              preview={heroDesktop}
              lang={lang}
              eager
              sizes="(min-width: 1152px) 470px, (min-width: 768px) 42vw, 76vw"
              class="mat frame-shadow ml-auto w-[84%] p-1.5 md:p-2"
            />
          )
        }
        {
          heroPhone && (
            <PreviewButton
              preview={heroPhone}
              lang={lang}
              sizes="(min-width: 1152px) 200px, (min-width: 768px) 18vw, 32vw"
              class="mat frame-shadow absolute bottom-0 left-0 w-[35%] p-1 md:p-1.5"
            />
          )
        }
        <Seal class="absolute right-1 bottom-0 md:right-3" />
      </div>
      <div>
        <p class="eyebrow">{t(home.hero.eyebrow, lang)}</p>
        <h1 class="mt-4 text-[2.15rem] leading-[1.14] md:mt-5 md:text-[2.6rem] md:leading-[1.1] lg:text-[3.6rem] lg:leading-[1.08]">{t(home.hero.headline, lang)}</h1>
        <p class="lead mt-4 max-w-xl md:mt-6">{t(home.hero.lead, lang)}</p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap md:mt-9">
          <a href="#packs" class="btn btn-primary sm:whitespace-nowrap">{t(home.hero.primary, lang)}</a>
          <a href={pagePath(lang, 'free-sample')} class="btn btn-ghost sm:whitespace-nowrap">{t(home.hero.secondary, lang)}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-line" aria-label={t(home.assurancesLabel, lang)}>
    <ul class="wrap grid grid-cols-2 gap-x-6 gap-y-7 py-9 md:grid-cols-4 md:gap-x-10 md:py-11">
      {
        home.assurances.map((item) => (
          <li>
            <p class="font-serif text-lg leading-snug">{t(item.title, lang)}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{t(item.body, lang)}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section id="packs" class="section">
    <div class="wrap">
      <p class="eyebrow">{t(home.packs.eyebrow, lang)}</p>
      <h2 class="h-section">{t(home.packs.heading, lang)}</h2>
      <p class="lead mt-4">{t(home.packs.lead, lang)}</p>
      <div class="mt-11 grid gap-x-7 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
        {products.map((product) => <ProductCard product={product} lang={lang} badge={product === bundle ? t(home.packs.bundleBadge, lang) : undefined} />)}
      </div>
      <PlaceholderNotice lang={lang} class="mt-12" />
    </div>
  </section>

  <section class="section bg-mat">
    <div class="wrap grid items-center gap-10 md:grid-cols-[1fr_auto] md:gap-16">
      <div>
        <p class="eyebrow">{t(home.sample.eyebrow, lang)}</p>
        <h2 class="h-section">{t(home.sample.heading, lang)}</h2>
        <p class="lead mt-4 max-w-xl">{t(home.sample.body, lang)}</p>
        <a href={pagePath(lang, 'free-sample')} class="btn btn-ghost mt-8">
          {t(home.sample.cta, lang)}<span aria-hidden="true">→</span>
        </a>
      </div>
      <ul class="flex items-end gap-3 md:gap-4" data-lightbox-group>
        {
          sampleImages.map((preview) => (
            <li class="bg-paper p-1" style={`flex: ${(preview.width / preview.height).toFixed(3)} 1 0%`}>
              <PreviewButton preview={preview} lang={lang} sizes="(min-width: 768px) 200px, 45vw" class="frame-shadow" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow">{t(home.gallery.eyebrow, lang)}</p>
      <h2 class="h-section">{t(home.gallery.heading, lang)}</h2>
      <ul class="mt-11 columns-2 gap-3 md:columns-3 lg:columns-4" data-lightbox-group>
        {picks.map((preview) => <li class="tile"><PreviewButton preview={preview} lang={lang} /></li>)}
      </ul>
      <a href={pagePath(lang, 'gallery')} class="btn btn-ghost mt-8">
        {t(home.gallery.cta, lang)}<span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid gap-6 md:grid-cols-[0.8fr_1.2fr] md:gap-14">
      <div>
        <p class="eyebrow">{t(home.ai.eyebrow, lang)}</p>
        <h2 class="h-section">{t(home.ai.heading, lang)}</h2>
      </div>
      <div>
        <p class="text-lg">{t(home.ai.body, lang)}</p>
        <a href={pagePath(lang, 'ai-disclosure')} class="link mt-4 inline-block">{t(home.ai.cta, lang)}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid gap-6 md:grid-cols-[0.8fr_1.2fr] md:gap-14">
      <div>
        <p class="eyebrow">{t(home.faq.eyebrow, lang)}</p>
        <h2 class="h-section">{t(home.faq.heading, lang)}</h2>
      </div>
      <div class="border-t border-line">
        {
          home.faq.items.map((item) => (
            <details class="group border-b border-line">
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 py-3 font-serif text-xl [&::-webkit-details-marker]:hidden">
                {t(item.q, lang)}
                <span class="text-seal transition-transform group-open:rotate-45" aria-hidden="true">+</span>
              </summary>
              <p class="pb-5 text-ink-soft">{t(item.a, lang)}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>
