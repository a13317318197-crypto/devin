---
// 联系页：只有邮箱，没有表单，不收集任何信息。
import { contactPage, site } from '../../content/site';
import Base from '../../layouts/Base.astro';
import { langStaticPaths, t, type Lang } from '../../lib/site';

export const getStaticPaths = langStaticPaths;
const lang = Astro.params.lang as Lang;
---

<Base lang={lang} page="contact" title={t(contactPage.title, lang)} description={t(contactPage.description, lang)}>
  <article class="wrap max-w-3xl py-12 md:py-16">
    <h1 class="h-page">{t(contactPage.heading, lang)}</h1>
    <p class="lead mt-5">{t(contactPage.lead, lang)}</p>
    <p class="mat mt-8 p-6">
      <span class="eyebrow block">{t(contactPage.emailLabel, lang)}</span>
      <a href={`mailto:${site.email}`} class="link mt-0.5 inline-block py-1.5 font-serif text-2xl break-all md:text-3xl">{site.email}</a>
    </p>
    <ul class="mt-8 divide-y divide-line border-y border-line">
      {contactPage.topics.map((topic) => <li class="py-3">{t(topic, lang)}</li>)}
    </ul>
  </article>
</Base>
