---
// 免费样图页：只有一个跳转 Gumroad 免费商品的按钮，本站不收集邮箱。
import { sample, samplePage, ui } from '../../content/site';
import BuyLink from '../../components/BuyLink.astro';
import PlaceholderNotice from '../../components/PlaceholderNotice.astro';
import PreviewButton from '../../components/PreviewButton.astro';
import Base from '../../layouts/Base.astro';
import { langStaticPaths, pagePath, previewsOf, t, type Lang } from '../../lib/site';

export const getStaticPaths = langStaticPaths;
const lang = Astro.params.lang as Lang;
const images = [previewsOf('phone')[1] ?? previewsOf('phone')[0], previewsOf('desktop')[1] ?? previewsOf('desktop')[0], previewsOf('avatar')[1] ?? previewsOf('avatar')[0]].filter(Boolean);
---

<Base lang={lang} page="free-sample" title={t(samplePage.title, lang)} description={t(samplePage.description, lang)}>
  <div class="wrap grid gap-10 py-12 md:grid-cols-2 md:gap-14 md:py-16">
    <div>
      <p class="eyebrow">{t(sample.name, lang)}<span aria-hidden="true"> · </span>{t(ui.free, lang)}</p>
      <h1 class="h-page mt-3">{t(samplePage.heading, lang)}</h1>
      <p class="lead mt-4">{t(samplePage.lead, lang)}</p>
      <BuyLink href={sample.gumroadUrl} lang={lang} label={t(samplePage.cta, lang)} class="mt-7 w-full sm:w-auto" />
      <ul class="mt-8 divide-y divide-line border-y border-line text-ink-soft">
        {samplePage.points.map((point) => <li class="py-3">{t(point, lang)}</li>)}
      </ul>
      <h2 class="mt-10 text-2xl">{t(samplePage.afterHeading, lang)}</h2>
      <a href={pagePath(lang) + '#packs'} class="btn btn-ghost mt-4">{t(ui.nav.packs, lang)}<span aria-hidden="true">→</span></a>
    </div>
    <div>
      <ul class="columns-2 gap-3" data-lightbox-group>
        {images.map((preview) => <li class="mat mb-3 break-inside-avoid p-1.5"><PreviewButton preview={preview} lang={lang} sizes="(min-width: 768px) 25vw, 45vw" /></li>)}
      </ul>
      <PlaceholderNotice lang={lang} class="mt-3" />
    </div>
  </div>
</Base>
