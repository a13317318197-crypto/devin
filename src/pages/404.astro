---
// 404 页：Cloudflare Pages 会自动用 dist/404.html。双语同时显示。
import { notFoundPage } from '../content/site';
import Base from '../layouts/Base.astro';
import { HTML_LANG, LANGS, pagePath, t } from '../lib/site';
---

<Base lang="en" page="" title={t(notFoundPage.title, 'en')} description={t(notFoundPage.body, 'en')} noindex>
  <div class="wrap max-w-3xl py-20 text-center md:py-28">
    <p class="eyebrow">404</p>
    {
      LANGS.map((lang, index) => {
        const Heading = index === 0 ? 'h1' : 'h2';
        return (
          <div class:list={index === 0 ? 'mt-5' : 'mt-12 border-t border-line pt-12'} lang={HTML_LANG[lang]}>
            <Heading class="text-3xl md:text-4xl">{t(notFoundPage.heading, lang)}</Heading>
            <p class="lead mt-3">{t(notFoundPage.body, lang)}</p>
            <a href={pagePath(lang)} class:list={['btn mt-6', index === 0 ? 'btn-primary' : 'btn-ghost']}>{t(notFoundPage.cta, lang)}</a>
          </div>
        );
      })
    }
  </div>
</Base>
